# Ignore editor and IDE settings
.idea/
.vscode/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
backup/
bin/
dist/
release/
node_modules/

# Ignore compiled binaries
main

# Ignore script and executable files
/release.sh
/x-ui

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go specific files
*.exe
*.exe~
vendor/

# --- ارتقا 1: نادیده گرفتن دیتابیس ---
# فایل‌های دیتابیس لوکال نباید در گیت باشند
*.db
*.db-shm
*.db-wal

# --- ارتقا 2: نادیده گرفتن گواهی‌های SSL (امنیتی) ---
# کلیدهای خصوصی و فایل‌های گواهی نباید اشتراک گذاشته شوند
*.pem
*.key
*.crt
fullchain.pem
privkey.pem

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env
.env.local
.env.*.local
