# ============================================================
# Database Configuration
# ============================================================
# Supported types: sqlite, mysql
XUI_DB_CONNECTION=sqlite

# If DB connection is "mysql", uncomment and fill these:
# XUI_DB_HOST=127.0.0.1
# XUI_DB_PORT=3306
# XUI_DB_DATABASE=xui
# XUI_DB_USERNAME=root
# XUI_DB_PASSWORD=your_secure_password_here

# ============================================================
# Panel Configuration (Recommended to be set here)
# ============================================================

# Panel Port (Example: 20543)
# XUI_PANEL_PORT=20543

# Panel Web Base Path (Randomized string for security)
# XUI_PANEL_BASE_PATH=/random_string_here

# Panel Username (Auto-generated if empty)
# XUI_PANEL_USERNAME=admin

# Panel Password (Auto-generated if empty)
# XUI_PANEL_PASSWORD=your_strong_password

# Listen IP (0.0.0.0 for all, 127.0.0.1 for local only)
# XUI_LISTEN_IP=0.0.0.0

# ============================================================
# SSL/TLS Configuration
# ============================================================

# Path to SSL Public Key (Full Chain)
# XUI_CERT_FILE=/root/cert/example.com/fullchain.pem

# Path to SSL Private Key
# XUI_CERT_KEY_FILE=/root/cert/example.com/privkey.pem

# ============================================================
# Security & Settings
# ============================================================

# Force VMess AEAD (Recommended: true for newer clients, false for old)
XRAY_VMESS_AEAD_FORCED=false

# Enable Fail2ban (Recommended: true)
X_UI_ENABLE_FAIL2BAN=true
